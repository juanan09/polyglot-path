# ==========================================
# 🔄 Dockerfile.migrate — Migraciones Drizzle
# Usado por DigitalOcean App Platform (Job PRE_DEPLOY)
# ==========================================

FROM node:22-alpine
ENV PNPM_HOME="/pnpm"
ENV PATH="$PNPM_HOME:$PATH"
RUN corepack enable

WORKDIR /app
ENV NODE_ENV=production
# drizzle-kit gestiona su propia conexión pg internamente,
# ignorando la config SSL de dbCredentials. Esta variable
# fuerza a Node.js a aceptar el certificado auto-firmado de DO.
ENV NODE_TLS_REJECT_UNAUTHORIZED=0

# Copiamos solo lo mínimo necesario para instalar deps y ejecutar migraciones
COPY package.json pnpm-lock.yaml pnpm-workspace.yaml* ./
RUN npm pkg delete scripts.prepare && \
    pnpm install --frozen-lockfile

# Copiamos los archivos de migración SQL y el script custom
COPY server/db/migrations/ ./server/db/migrations/
COPY scripts/migrate.mjs ./scripts/migrate.mjs

# Ejecutar las migraciones con el script custom (sin drizzle-kit)
CMD ["node", "scripts/migrate.mjs"]
