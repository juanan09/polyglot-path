# ============================================================
# .gitignore — Polyglot Path
# Nuxt 4 | PostgreSQL (Drizzle) | Docker | LLM + Genkit
# ============================================================

# ──────────────────────────────────────────────────────────────
# Nuxt 4 / Nitro build & dev outputs
# ──────────────────────────────────────────────────────────────
.output/
.nuxt/
.nitro/
.cache/
.data/
dist/
.vercel/
.netlify/

# ──────────────────────────────────────────────────────────────
# Node / pnpm
# ──────────────────────────────────────────────────────────────
node_modules/
*.tgz
.pnpm-store/
.pnpm-debug.log

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ──────────────────────────────────────────────────────────────
# Environment variables
# ──────────────────────────────────────────────────────────────
.env
.env.*
!.env.example
!.env.template

# ──────────────────────────────────────────────────────────────
# TypeScript
# ──────────────────────────────────────────────────────────────
*.tsbuildinfo

# ──────────────────────────────────────────────────────────────
# PostgreSQL / Drizzle ORM
# ──────────────────────────────────────────────────────────────
# Drizzle local dev meta (generated by drizzle-kit)
drizzle/meta/

# PostgreSQL local data (docker volume mount)
pgdata/
postgres-data/
db-data/

# Database dumps / backups
*.sql
*.dump
*.pgdump
!drizzle/**/*.sql
!migrations/**/*.sql
!server/db/migrations/**/*.sql

# ──────────────────────────────────────────────────────────────
# Docker
# ──────────────────────────────────────────────────────────────
# Docker overrides locales (la config base se sube al repo)
docker-compose.override.yml
docker-compose.override.yaml

# Data volumes montados localmente
docker-data/
volumes/

# ──────────────────────────────────────────────────────────────
# LLM / Google Genkit
# ──────────────────────────────────────────────────────────────
# Genkit local traces & dev artifacts
.genkit/

# Modelo caches / pesos descargados
models/
*.gguf
*.bin
*.safetensors
*.onnx
*.pt
*.pth

# Embeddings & vector stores locales
embeddings/
vector-store/
*.faiss
*.index

# LLM prompt/response logs (pueden contener datos sensibles)
llm-logs/
prompt-logs/
ai-debug/

# API keys / credentials para servicios LLM
*-credentials.json
*-service-account.json
gcloud-*.json
firebase-*.json
!firebase.json

# ──────────────────────────────────────────────────────────────
# IDE / Editores
# ──────────────────────────────────────────────────────────────
.vscode/
!.vscode/settings.json
!.vscode/extensions.json
!.vscode/launch.json
.idea/
*.swp
*.swo
*~
.fleet/

# ──────────────────────────────────────────────────────────────
# Sistema operativo
# ──────────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ──────────────────────────────────────────────────────────────
# Testing / Coverage
# ──────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
playwright-report/

# ──────────────────────────────────────────────────────────────
# Misc
# ──────────────────────────────────────────────────────────────
*.local
.temp/
tmp/

# ──────────────────────────────────────────────────────────────
# Docs
# ──────────────────────────────────────────────────────────────
# We ignore all docs by default, but allow only the specific guide files
docs/*
!docs/CrearHistoriasNuevas.md
!docs/CreateNewStories.md
!docs/Despliegue_Docker.md
!docs/Docker_Deployment.md
!docs/Despliegue_DigitalOcean.md
!docs/DigitalOcean_Deployment.md
!docs/assets/