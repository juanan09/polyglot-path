# ==========================================
# 🌿 .env.example
# Plantilla base para copiar como `.env`
# ==========================================

# Variables para PostgreSQL
POSTGRES_USER=user
POSTGRES_PASSWORD=polyglot123
POSTGRES_DB=polyglot_path

# Variables de acceso a pgAdmin (http://localhost:5050)
PGADMIN_EMAIL=admin@polyglot.com
PGADMIN_PASSWORD=admin123

# Conexión DB en formato Prisma/Drizzle: postgres://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgres://polyglot:polyglot123@localhost:5432/polyglot_path

# ==========================================
# 🤖 LLM Provider
# Opciones: 'google' | 'ollama' | 'groq'
# ==========================================
LLM_PROVIDER=groq

# Google AI (LLM_PROVIDER=google)
# GOOGLE_GENAI_API_KEY=tu_api_key_aqui

# Ollama — local, gratuito (LLM_PROVIDER=ollama)
# OLLAMA_MODEL=phi4-mini
# OLLAMA_HOST=http://127.0.0.1:11434

# Groq — cloud, free tier 14.400 req/día (LLM_PROVIDER=groq)
# GROQ_API_KEY=tu_groq_api_key_aqui
